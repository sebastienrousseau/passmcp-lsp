[codespell]
skip = ./build,./dist,./.git,./go.sum,*.svg,*.png,./LICENSE,./LICENSES,./editors/vscode/node_modules,./editors/vscode/out,./editors/vscode/LICENSE,./editors/vscode/package-lock.json,./internal/check/schemas
# intoto: in-toto attestation format.
ignore-words-list = intoto
quiet-level = 3
